# Firebase Configuration
# Create a Firebase project at https://console.firebase.google.com
# Enable Authentication: Google provider + Email/Password
# Then copy your web app's config values here.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# OpenRouter AI API (server-side only)
# Used by the /api/chat serverless function. NEVER prefix with VITE_.
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
API_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# App Configuration
# Used for HTTP-Referer header sent to OpenRouter from the serverless function
SITE_URL=https://your-app.vercel.app

# External Services
# URL template for exercise image placeholders
VITE_PLACEHOLDER_IMAGE_URL=https://placehold.co/400x300/1a1a2e/e0e0e0?text=